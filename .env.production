# Production build config (mode=production). Takes precedence over .env.local so
# a leftover local-dev .env.local (which points at http://localhost:8000) cannot
# poison the deployed bundle. Same-origin: nginx serves the build and proxies
# /api and /ws to the backend, so relative URLs work on any domain.
VITE_API_URL=/api
VITE_WS_URL=
VITE_GOOGLE_CLIENT_ID=860732387709-kurtttd0m4nc40mjfvngqh0cklat7odv.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://aiaas.kaushaljain.com/auth/google/callback
